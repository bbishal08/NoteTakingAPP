{
  "name": "noteflow-desktop",
  "version": "1.0.0",
  "description": "All-in-one local-first Desktop Note-Taking Workspace with Projects, Folders, Tags, Knowledge Graph, Kanban, and Hybrid Rich/Markdown/Block Editor",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "tsc && vite build",
    "test": "vitest run",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  }
}
